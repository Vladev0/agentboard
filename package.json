{
  "name": "agentboard",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local kanban task board for humans and AI coding agents, backed by a markdown vault.",
  "homepage": "https://vladev0.github.io/agentboard/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vladev0/agentboard.git"
  },
  "bugs": {
    "url": "https://github.com/Vladev0/agentboard/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "kanban",
    "local-first",
    "task-management"
  ],
  "mcpName": "io.github.vladev0/agentboard",
  "scripts": {
    "setup": "npm install && npm --prefix web install",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "build": "npm run build:web && tsc -p tsconfig.json",
    "build:site": "node scripts/build-discovery-site.mjs",
    "build:mcpb-stage": "node scripts/build-mcpb-stage.mjs",
    "validate:distribution": "node scripts/validate-distribution.mjs",
    "start": "node dist/server/index.js",
    "mcp": "tsx src/mcp/index.ts",
    "seed": "tsx src/core/seed.ts",
    "seed:promo": "tsx src/core/seed-promo.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^3.6.0",
    "fastify": "^4.28.1",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
